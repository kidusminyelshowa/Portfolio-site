# Copy this file to .env (self-hosting) or add the lines you need in Vercel → Settings → Environment Variables.
# Never commit the real .env.

# --- the only required setting -------------------------------------------------
# The "Setup key" asked for once, when you create the first admin at /team (12+ characters).
SETUP_TOKEN=

# --- storage ---------------------------------------------------------------------
# blob  = Vercel Blob (default). Create ONE private Blob store and connect it to the project:
#         Vercel then sets BLOB_READ_WRITE_TOKEN by itself.
# local = a folder on this server (self-hosting; set STORAGE_DIR).
STORAGE=blob
STORAGE_DIR=./data

# --- optional ----------------------------------------------------------------------
# Turns on the daily jobs on Vercel (any random text). Self-hosting runs them without it.
CRON_SECRET=
# Push notifications on phones. Generate a pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
# Signs sign-in cookies. Leave empty and the server makes one and keeps it in storage.
SESSION_SECRET=
# Advanced: separate stores. LEADS_BLOB_TOKEN overrides BLOB_READ_WRITE_TOKEN for the private
# store; MEDIA_BLOB_TOKEN puts photos and the logo in a separate PUBLIC store.
LEADS_BLOB_TOKEN=
MEDIA_BLOB_TOKEN=

# Decap CMS sign-in at /admin (portfolio content only)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Self-hosting only: the port server.js listens on
PORT=3000
