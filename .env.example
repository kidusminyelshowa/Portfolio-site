# Copy this file to .env (self-hosting) or add each line in Vercel → Project → Settings → Environment Variables.
# Never commit the real .env.

# --- required ---------------------------------------------------------------
# Signs the sign-in cookies. Any long random text (32+ characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# The "Setup key" asked for once, when you create the first admin at /team.
# At least 12 characters. You can delete it after setup to switch setup off.
SETUP_TOKEN=
# Protects /api/cron. Vercel sends it automatically to its own cron jobs.
CRON_SECRET=

# --- storage ----------------------------------------------------------------
# blob  = Vercel Blob (default; needs the two tokens below)
# local = a folder on this server (self-hosting; set STORAGE_DIR)
STORAGE=blob
# Vercel Blob: create two stores (Storage → Blob). One PRIVATE store for the
# team database, quotes, leads and settings; one PUBLIC store for photos and logos.
LEADS_BLOB_TOKEN=
MEDIA_BLOB_TOKEN=
# Only for STORAGE=local: where the data lives (needs a private/ and public/ inside; made automatically)
STORAGE_DIR=./data

# --- optional ---------------------------------------------------------------
# Push notifications on phones. Generate a pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services: mailto:you@yourdomain.com or https://yourdomain.com
VAPID_SUBJECT=mailto:hello@example.com

# Decap CMS sign-in at /admin (portfolio content only)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Self-hosting only: the port server.js listens on
PORT=3000
